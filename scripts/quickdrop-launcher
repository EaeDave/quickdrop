#!/usr/bin/env bash
set -euo pipefail

lock_path="${XDG_RUNTIME_DIR:-/tmp}/quickdrop-launcher.lock"
exec 9>"$lock_path"
# Drop duplicate clicks instead of queueing launchers behind the active one.
flock -n 9 || exit 0

quickdrop_bin="${QUICKDROP_BIN:-$HOME/.local/bin/quickdrop}"
config_path="${QUICKDROP_CONFIG:-$HOME/.config/quickdrop/config.env}"
config_api_base_url=""
if [[ -f "$config_path" ]]; then
  # Read only the supported key; never execute config file contents.
  config_api_base_url="$(
    sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?QUICKDROP_API_BASE_URL=//p' "$config_path" |
      tail -n 1 |
      sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
  )"
fi
api_base_url="${QUICKDROP_API_BASE_URL:-${config_api_base_url:-${QUICKDROP_PUBLIC_BASE_URL:-__QUICKDROP_PUBLIC_BASE_URL__}}}"
api_base_url="${api_base_url%/}"
window_width="${QUICKDROP_WINDOW_WIDTH:-380}"
window_height="${QUICKDROP_WINDOW_HEIGHT:-360}"

cursor_position="$(hyprctl cursorpos 2>/dev/null || printf '')"
cursor_x="${cursor_position%%,*}"
cursor_y="${cursor_position#*, }"

has_cursor=1
if [[ -z "$cursor_position" || "$cursor_x" == "$cursor_position" || -z "$cursor_y" ]]; then
  has_cursor=0
fi

if (( has_cursor )); then
  read -r window_x window_y rule_x rule_y < <(
    MONITORS_JSON="$(hyprctl monitors -j)" \
    QUICKDROP_LAUNCHER_X="$cursor_x" \
    QUICKDROP_LAUNCHER_Y="$cursor_y" \
    QUICKDROP_WINDOW_WIDTH="$window_width" \
    QUICKDROP_WINDOW_HEIGHT="$window_height" \
    bun -e '
const monitors = JSON.parse(process.env.MONITORS_JSON || "[]");
const cursorX = Number(process.env.QUICKDROP_LAUNCHER_X);
const cursorY = Number(process.env.QUICKDROP_LAUNCHER_Y);
const windowWidth = Number(process.env.QUICKDROP_WINDOW_WIDTH);
const windowHeight = Number(process.env.QUICKDROP_WINDOW_HEIGHT);

let x = Math.round(cursorX - windowWidth / 2);
let y = Math.round(cursorY + 10);
const monitor = monitors.find((item) => (
  cursorX >= item.x && cursorX < item.x + item.width &&
  cursorY >= item.y && cursorY < item.y + item.height
)) ?? monitors.find((item) => item.focused) ?? monitors[0];

if (monitor) {
  const reserved = Array.isArray(monitor.reserved) ? monitor.reserved : [0, 0, 0, 0];
  const minX = monitor.x + reserved[0];
  const minY = monitor.y + reserved[1];
  const maxX = monitor.x + monitor.width - reserved[2] - windowWidth;
  const maxY = monitor.y + monitor.height - reserved[3] - windowHeight;
  x = Math.min(Math.max(x, minX), Math.max(maxX, minX));
  y = Math.min(Math.max(y, minY), Math.max(maxY, minY));
}

console.log(`${x} ${y} ${x - (monitor?.x ?? 0)} ${y - (monitor?.y ?? 0)}`);
'
  )
fi

quickdrop_window_addresses() {
  hyprctl clients -j | bun -e '
const clients = JSON.parse(await Bun.stdin.text());
for (const client of clients) {
  if (client.class === "quickdrop" || client.initialClass === "quickdrop") {
    console.log(client.address);
  }
}
'
}

disable_spawn_rule() {
  hyprctl eval 'if _G.quickdrop_spawn_rule then _G.quickdrop_spawn_rule:set_enabled(false); _G.quickdrop_spawn_rule = nil end' >/dev/null 2>&1 || true
}

install_spawn_rule() {
  (( has_cursor )) || return 1
  disable_spawn_rule
  hyprctl eval "_G.quickdrop_spawn_rule = hl.window_rule({ name = 'quickdrop-spawn', match = { class = '^quickdrop$' }, float = true, move = { $rule_x, $rule_y }, no_initial_focus = true, no_anim = true })" >/dev/null 2>&1
}

place_quickdrop_window() {
  local primary="$1"
  local should_focus="${2:-0}"
  local selector="address:$primary"

  # Hyprland 0.56+ dispatchers use Lua expressions. Fall back to the legacy
  # dispatcher syntax for older Hyprland releases.
  if hyprctl dispatch "hl.dsp.window.float({ action = 'set', window = '$selector' })" >/dev/null 2>&1; then
    if (( has_cursor )); then
      hyprctl dispatch "hl.dsp.window.move({ x = $window_x, y = $window_y, window = '$selector' })" >/dev/null 2>&1 || true
    fi
    if (( should_focus )); then
      hyprctl dispatch "hl.dsp.focus({ window = '$selector' })" >/dev/null 2>&1 || true
    fi
    return
  fi

  if (( has_cursor )); then
    hyprctl dispatch movewindowpixel exact "$window_x" "$window_y,$selector" >/dev/null 2>&1 || true
  fi
  if (( should_focus )); then
    hyprctl dispatch focuswindow "$selector" >/dev/null 2>&1 || true
  fi
}

close_quickdrop_window() {
  local address="$1"
  local selector="address:$address"
  hyprctl dispatch "hl.dsp.window.close({ window = '$selector' })" >/dev/null 2>&1 ||
    hyprctl dispatch closewindow "$selector" >/dev/null 2>&1 || true
}

mapfile -t quickdrop_windows < <(quickdrop_window_addresses)

if (( ${#quickdrop_windows[@]} > 0 )); then
  primary="${quickdrop_windows[0]}"
  place_quickdrop_window "$primary" 1

  for extra in "${quickdrop_windows[@]:1}"; do
    close_quickdrop_window "$extra"
  done

  exit 0
fi

spawn_rule_installed=0
if install_spawn_rule; then
  spawn_rule_installed=1
fi
cleanup_spawn_rule() {
  if (( spawn_rule_installed )); then
    disable_spawn_rule
  fi
}
trap cleanup_spawn_rule EXIT

launcher_env=(
  "WEBKIT_DISABLE_DMABUF_RENDERER=1"
  "QUICKDROP_API_BASE_URL=$api_base_url"
)
if (( has_cursor )); then
  launcher_env+=("QUICKDROP_LAUNCHER_X=$cursor_x" "QUICKDROP_LAUNCHER_Y=$cursor_y")
fi
# Do not leak the launcher lock into the long-running Tauri process.
nohup env "${launcher_env[@]}" "$quickdrop_bin" >/dev/null 2>&1 9>&- &

for _ in {1..100}; do
  sleep 0.05
  mapfile -t quickdrop_windows < <(quickdrop_window_addresses)

  if (( ${#quickdrop_windows[@]} > 0 )); then
    primary="${quickdrop_windows[0]}"
    disable_spawn_rule
    spawn_rule_installed=0
    place_quickdrop_window "$primary" 0

    for extra in "${quickdrop_windows[@]:1}"; do
      close_quickdrop_window "$extra"
    done

    exit 0
  fi
done
